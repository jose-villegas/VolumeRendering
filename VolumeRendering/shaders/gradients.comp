#version 430
layout (local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(binding=0) uniform sampler3D volume;
layout(binding=1, rgba16f) uniform writeonly image3D gradients;

// relative voxel spacing per axis, the volume's aspect ratios
uniform vec3 spacing;

float density(ivec3 p, ivec3 size)
{
    return texelFetch(volume, clamp(p, ivec3(0), size - 1), 0).r;
}

void main()
{
    ivec3 size = textureSize(volume, 0);
    ivec3 pos = ivec3(gl_GlobalInvocationID);

    if (any(greaterThanEqual(pos, size))) return;

    // central differences, density increases along the gradient
    vec3 g;
    g.x = density(pos + ivec3(1, 0, 0), size) - density(pos - ivec3(1, 0, 0), size);
    g.y = density(pos + ivec3(0, 1, 0), size) - density(pos - ivec3(0, 1, 0), size);
    g.z = density(pos + ivec3(0, 0, 1), size) - density(pos - ivec3(0, 0, 1), size);
    g *= 0.5 / spacing;

    // the gradient is kept unnormalized so it can be filtered, w holds its magnitude
    imageStore(gradients, pos, vec4(g, length(g)));
}
