#version 430
layout (local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

// separable 5-tap binomial filter, run once per axis between two textures
layout(binding=0) uniform sampler3D source;
layout(binding=1, rgba16f) uniform writeonly image3D destination;

uniform ivec3 axis;

const float weights[5] = float[](1.0, 4.0, 6.0, 4.0, 1.0);

void main()
{
    ivec3 size = textureSize(source, 0);
    ivec3 pos = ivec3(gl_GlobalInvocationID);

    if (any(greaterThanEqual(pos, size))) return;

    vec4 sum = vec4(0);
    float total = 0.0;

    for (int i = -2; i <= 2; i++)
    {
        ivec3 p = pos + axis * i;

        if (all(greaterThanEqual(p, ivec3(0))) && all(lessThan(p, size)))
        {
            sum += weights[i + 2] * texelFetch(source, p, 0);
            total += weights[i + 2];
        }
    }

    imageStore(destination, pos, sum / total);
}
